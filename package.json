{
  "name": "minetur-client",
  "version": "1.0.0",
  "description": "A typescript client to fetch fuel data from Spanish MineTur API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/dev.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "pnpm run lint && pnpm run test && tsup src/index.ts --format cjs,esm --dts --clean"
  },
  "keywords": [
    "minetur",
    "fuel",
    "spain",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@stylistic/eslint-plugin": "^2.0.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^9.0.0",
    "eslint-plugin-import-x": "^4.17.1",
    "jiti": "^2.7.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}